{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meme-game.local/schemas/auth/v1.json",
  "title": "MemeGameAuth",
  "description": "搞事事账号与进度契约 v1",
  "definitions": {
    "user_profile": {
      "type": "object",
      "required": ["user_id", "username", "display_name", "created_at"],
      "properties": {
        "user_id": { "type": "string" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32 },
        "display_name": { "type": "string", "maxLength": 64 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "auth_token_response": {
      "type": "object",
      "required": ["access_token", "token_type", "expires_in", "user"],
      "properties": {
        "access_token": { "type": "string" },
        "token_type": { "type": "string", "const": "Bearer" },
        "expires_in": { "type": "integer", "minimum": 1 },
        "user": { "$ref": "#/definitions/user_profile" }
      }
    },
    "level_progress": {
      "type": "object",
      "required": ["level_id"],
      "properties": {
        "level_id": { "type": "string" },
        "best_stars": { "type": "integer", "minimum": 0, "maximum": 3 },
        "best_time_seconds": { "type": "number", "minimum": 0 },
        "best_coins": { "type": "integer", "minimum": 0 },
        "clear_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "last_reason": { "type": "string" },
        "last_played_at": { "type": "string", "format": "date-time" }
      }
    },
    "session_submit": {
      "type": "object",
      "required": ["level_id", "reason", "coins", "total_coins", "seconds"],
      "properties": {
        "level_id": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": ["victory", "fellOff", "hitByEnemy", "timeUp", "fakeGoal"]
        },
        "coins": { "type": "integer", "minimum": 0 },
        "total_coins": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "number", "minimum": 0 },
        "stars": { "type": "integer", "minimum": 0, "maximum": 3 },
        "defeated_enemies": { "type": "integer", "minimum": 0 },
        "trace_id": { "type": "string" }
      }
    }
  }
}
